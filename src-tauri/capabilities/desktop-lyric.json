{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-lyric",
  "description": "Minimal least-privilege capability for the standalone desktop_lyric overlay window",
  "windows": ["desktop_lyric"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
